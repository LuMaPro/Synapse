# Copie para .env e ajuste. O .env nunca vai para o git.

# Chave secreta do Django. Gere uma com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-secreta

# True só em desenvolvimento
DEBUG=True

# Hosts permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços do frontend que podem chamar a API, separados por vírgula. O padrão
# (sem esta linha) é http://localhost:5173,http://localhost:4173. Para testar no
# celular pela rede local, acrescente o endereço do computador, ex.:
# http://192.168.0.10:5173 (e o IP em ALLOWED_HOSTS).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Banco PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Este valor bate com o container sugerido no README.
DATABASE_URL=postgres://synapse:synapse@localhost:5432/synapse

# Chave para assinatura dos tokens JWT (opcional; se omitida, usa a SECRET_KEY)
# JWT_SIGNING_KEY=troque-por-uma-chave-jwt-segura

# Produção (issue #38, veja docs/deploy.md). No Render, estas ficam no painel:
#   DEBUG=False, DATABASE_URL do Neon, CORS_ALLOWED_ORIGINS com o endereço do
#   frontend. O endereço da API entra sozinho no ALLOWED_HOSTS
#   (RENDER_EXTERNAL_HOSTNAME).
# Segundos para reaproveitar a conexão com o banco (0 = uma por requisição)
# CONN_MAX_AGE=60
# Com DEBUG=False, o HTTP é redirecionado para HTTPS. Desligue só para testar a
# imagem de produção localmente, sem HTTPS.
# SECURE_SSL_REDIRECT=False
