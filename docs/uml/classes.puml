  }
  interface RepositorioSessao <<Repository>> $REPOSITORY {
    + salvar(sessao) {abstract}
    + buscar_por_id(id): SessaoFoco | None {abstract}
    + listar_por_usuario(usuario_id): list[SessaoFoco] {abstract}
    + listar_por_periodo(usuario_id, de, ate): list[SessaoFoco] {abstract}
    + listar_historico(usuario_id, de, ate, estado, deslocamento, limite) {abstract}
    + buscar_ativa_por_usuario(usuario_id): SessaoFoco | None {abstract}
    + listar_em_andamento(): list[SessaoFoco] {abstract}
    + remover(id) {abstract}
  }
  interface RepositorioNeuronio <<Repository>> $REPOSITORY {
    + salvar(neuronio) {abstract}
    + buscar_por_sessao(sessao_id): Neuronio | None {abstract}
    + listar_por_usuario(usuario_id): list[Neuronio] {abstract}
  }
  note bottom of RepositorioNeuronio
    Os serviços não o usam: os neurônios
    são gravados com a rede (RepositorioRedeNeural).
  end note
  interface RepositorioRedeNeural <<Repository>> $REPOSITORY {
    + carregar(usuario_id, regra): RedeNeural {abstract}
    + salvar(rede) {abstract}
  }
  interface RepositorioMateria <<Repository>> $REPOSITORY {
    + salvar(materia) {abstract}
    + buscar_por_id(id): Materia | None {abstract}
    + buscar_por_usuario_e_id(usuario_id, id): Materia | None {abstract}
    + listar_por_usuario(usuario_id): list[Materia] {abstract}
    + existe_com_nome(usuario_id, nome, ignorar_id): bool {abstract}
    + remover(id) {abstract}
  }
  interface RepositorioConquista <<Repository>> $REPOSITORY {
    + listar_por_usuario(usuario_id): list[ConquistaDesbloqueada] {abstract}
    + salvar(conquista) {abstract}
  }
  interface RepositorioCarteira <<Repository>> $REPOSITORY {
    + carregar(usuario_id, para_alterar): Carteira {abstract}
