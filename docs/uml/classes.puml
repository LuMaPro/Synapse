@startuml classes-rede
!include estilo-classes.iuml
title Neurônio e rede neural: Factory Method, Strategy e Agregado
$legenda_padroes()

class Entidade $REF
class SessaoFoco $REF
class Duracao $REF
class Materia $REF

class Neuronio {
  - vivo: bool
  - criado_em: datetime
  + /cor: str
  + /numero_dendritos: int
  + /raio: float
}

class Sinapse {
  - peso: int
  - criada_em: datetime
  + /par: frozenset[UUID]
}

abstract class TipoNeuronio <<Factory Method: produto>> $FACTORY {
  + duracao_minima: int {static}
  + duracao_maxima: int | None {static}
  + /nome: str {abstract}
  + /cor: str {abstract}
  + /numero_dendritos: int {abstract}
  + /raio: float {abstract}
  + /codigo: str
  + aceita(duracao_minutos): bool
}
class Granular <<Factory Method: produto>> $FACTORY {
  10 a 24 min, 3 dendritos
}
class Piramidal <<Factory Method: produto>> $FACTORY {
  25 a 59 min, 5 dendritos
}
class Purkinje <<Factory Method: produto>> $FACTORY {
  60 min ou mais, 8 dendritos
}

class FabricaNeuronio <<Factory Method: criador>> $FACTORY {
  + TIPOS_PADRAO: tuple[TipoNeuronio] {static}
  + tipo_para(duracao_minutos): TipoNeuronio
  + criar(sessao: SessaoFoco): Neuronio
}
class _MetodoFabrica <<descritor>> $FACTORY {
  - func
  + __get__(instancia, dono)
}
note right of _MetodoFabrica
  Deixa chamar FabricaNeuronio.criar(sessao)
  na classe (tipos padrão) ou numa fábrica
  montada com outros tipos.
end note

class RedeNeural <<Agregado>> $AGREGADO {
  - em_ordem: list[Neuronio]
  - sessoes: set[UUID]
  - pares: set[frozenset[UUID]]
  - sinapses_por_neuronio: dict[UUID, list[Sinapse]]
  + /vivos: list[Neuronio]
  + /neuronios_novos: list[Neuronio]
  + /sinapses_novas: list[Sinapse]
  + adicionar(neuronio): list[Sinapse]
  + neuronio(neuronio_id): Neuronio | None
  + sinapses_de(neuronio_id): list[Sinapse]
  + recortar(de, ate, materia_id): RecorteRede
  + marcar_como_salva()
  - _exigir_admissivel(neuronio)
  - _exigir_ligavel(sinapse, novo, pares_novos)
  - _incluir_neuronio(neuronio)
  - _incluir_sinapse(sinapse)
}
note bottom of RedeNeural
  Única porta para mudar a rede: sinapse só entre
  neurônios vivos do mesmo estudante, sem repetir.
end note

class RecorteRede <<objeto de valor>>

interface RegraFormacaoSinapses <<Strategy>> $STRATEGY {
  + conexoes(novo, rede): list[Conexao] {abstract}
}
class RegraRecentesEMesmaMateria <<Strategy>> $STRATEGY {
  - recentes: int = 2
  - peso_maximo: int = 5
  + conexoes(novo, rede): list[Conexao]
  - _ultimo_da_materia(novo, anteriores): Neuronio | None {static}
  - _peso_da_trilha(neuronio, rede): int {static}
}
class Conexao <<objeto de valor>> {
  + peso: int
}

