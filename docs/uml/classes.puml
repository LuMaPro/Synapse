@startuml classes-sessao
!include estilo-classes.iuml
title Sessão de foco: State (ciclo de vida) e Strategy (saída da tela)
$legenda_padroes()

class Entidade {
  - id: UUID
  + __eq__(outro): bool
  + __hash__(): int
}

class Usuario {
  + NOME_MAX: int = 150 {static}
  + EMAIL_MAX: int = 254 {static}
  - nome: str
  - email: str
  - criado_em: datetime
  - _validar_nome(nome): str {static}
  - _normalizar_email(email): str {static}
}

class Materia {
  + NOME_MAX: int = 100 {static}
  - nome: str
  - cor: str
  - criada_em: datetime
  + atualizar(nome, cor)
  - _validar_nome(nome): str {static}
  - _normalizar_cor(cor): str {static}
}

class SessaoFoco <<contexto do State e do Strategy>> $STATE {
  - inicio: datetime
  - encerrada_em: datetime | None
  + /fim_previsto: datetime
  + /estado: str
  + /codigo_estado: str
  + /tempo_fora: timedelta
  + /curta_demais: bool
  + concluir(relogio)
  + podar(relogio)
  + desistir(relogio)
  + registrar_interrupcao(interrupcao)
  + expirar_se_abandonada(instante): bool
  + restante_em(instante): timedelta
  ~ _mudar_estado(novo_estado, instante)
  ~ _aplicar_politica(interrupcao)
  - _relogio_validado(relogio): Callable
}

class Duracao <<objeto de valor>> {
  + MINIMA: int = 10 {static}
  + MAXIMA: int = 120 {static}
  + PASSO: int = 5 {static}
  + minutos: int
  + como_timedelta(): timedelta
}

abstract class EstadoSessao <<State>> $STATE {
  + /nome: str {abstract}
  + /codigo: str {abstract}
  + concluir(sessao, relogio)
  + podar(sessao, relogio)
  + desistir(sessao, relogio)
  + registrar_interrupcao(sessao, interrupcao)
  + expirar(sessao, instante): bool
}
class EmAndamento <<State>> $STATE {
  + concluir(sessao, relogio)
  + podar(sessao, relogio)
  + desistir(sessao, relogio)
  + registrar_interrupcao(sessao, interrupcao)
  + expirar(sessao, instante): bool
}
class Concluida <<State>> $STATE
class Podada <<State>> $STATE
note bottom of Concluida
  Estados finais: herdam as transições
  da base, que lançam TransicaoInvalida.
end note

abstract class PoliticaInterrupcao <<Strategy>> $STRATEGY {
  + /codigo: str {abstract}
  + deve_podar(sessao, nova_interrupcao, historico): bool {abstract}
  + instante_da_poda(sessao, nova_interrupcao, historico): datetime
}
class ModoEstrito <<Strategy>> $STRATEGY {
  + deve_podar(sessao, nova_interrupcao, historico): bool
}
class ModoTolerante <<Strategy>> $STRATEGY {
  + proporcao: float = 0.10
  + deve_podar(sessao, nova_interrupcao, historico): bool
  + instante_da_poda(sessao, nova_interrupcao, historico): datetime
  - _saldo_restante(sessao, historico): float
}

class Interrupcao <<objeto de valor>> {
  + saida: datetime
  + retorno: datetime | None
  + /segundos_fora: float
}

Entidade <|-- Usuario
Entidade <|-- Materia
Entidade <|-- SessaoFoco
EstadoSessao <|-- EmAndamento
EstadoSessao <|-- Concluida
EstadoSessao <|-- Podada
PoliticaInterrupcao <|-- ModoEstrito
PoliticaInterrupcao <|-- ModoTolerante

SessaoFoco *-- "1" Duracao : duracao
SessaoFoco *-- "1" EstadoSessao : estado
SessaoFoco o-- "1" PoliticaInterrupcao : politica
SessaoFoco *-- "0..*" Interrupcao : historico_interrupcoes
SessaoFoco "0..*" --> "0..1" Materia : materia_id
